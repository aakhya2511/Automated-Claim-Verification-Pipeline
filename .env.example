# Copy to `.env` and edit. `.env` is gitignored; never commit real credentials.
#
# Naming: ACV_<SECTION>__<FIELD>. Nesting uses a double underscore.
# Every value below is optional — the defaults run the service with the
# deterministic fake rater and no external dependencies.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ACV_ENVIRONMENT=local
# Behavioural profile loaded from configs/. Use baseline.yaml to run the
# naive single-shot-LLM arm.
ACV_PIPELINE_CONFIG_FILE=optimized.yaml

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
ACV_SERVER__HOST=127.0.0.1
ACV_SERVER__PORT=8000
ACV_SERVER__MAX_REQUEST_BYTES=262144
ACV_SERVER__MAX_BATCH_ITEMS=100
ACV_SERVER__BATCH_CONCURRENCY=16
ACV_SERVER__VERIFICATION_TIMEOUT_SECONDS=10.0

# ---------------------------------------------------------------------------
# Semantic rater (LLM)
# ---------------------------------------------------------------------------
# fake     -> deterministic in-process rater. Default; required for CI, unit
#             tests and reproducible evaluation. No network calls.
# openai   -> OpenAI Responses API with strict structured output.
ACV_LLM__PROVIDER=fake

# Required when provider != fake. Startup fails with a configuration error if
# a real provider is selected without a key.
# ACV_LLM__API_KEY=sk-replace-me

# Optional override for gateways, proxies, or self-hosted OpenAI-compatible
# servers (vLLM, LiteLLM, Azure).
# ACV_LLM__BASE_URL=https://api.openai.com/v1

ACV_LLM__MODEL=gpt-4o-mini
ACV_LLM__TIMEOUT_SECONDS=6.0
ACV_LLM__CONNECT_TIMEOUT_SECONDS=2.0
ACV_LLM__MAX_RETRIES=2
ACV_LLM__RETRY_BASE_DELAY_SECONDS=0.25
ACV_LLM__MAX_CONNECTIONS=32
ACV_LLM__MAX_KEEPALIVE_CONNECTIONS=16
ACV_LLM__MAX_CONCURRENCY=8
ACV_LLM__TEMPERATURE=0.0
ACV_LLM__RATER_PROMPT_VERSION=v1
ACV_LLM__EXTRACTION_PROMPT_VERSION=v1
ACV_LLM__SCHEMA_VERSION=1.0
ACV_LLM__MAX_OUTPUT_TOKENS=256

# ---------------------------------------------------------------------------
# Data locations
# ---------------------------------------------------------------------------
ACV_DATA__REFERENCE_CATALOG_PATH=data/reference/catalog.jsonl
ACV_DATA__EVALUATION_DATASET_PATH=data/evaluation/v1/benchmark_500.jsonl
ACV_DATA__ARTIFACTS_DIR=artifacts

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
ACV_OBSERVABILITY__LOG_LEVEL=INFO
# json for production log pipelines, console for local readability.
ACV_OBSERVABILITY__LOG_FORMAT=json
ACV_OBSERVABILITY__METRICS_ENABLED=true
# Raw claim text is user-supplied content, so it is off by default.
ACV_OBSERVABILITY__LOG_CLAIM_TEXT=false
# Config-echo and cache-stats endpoints. Rejected at startup in production.
ACV_OBSERVABILITY__EXPOSE_DEBUG_ENDPOINTS=false
